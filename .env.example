# Copia este archivo como ".env" (en la misma carpeta) y pon tus claves.
# El archivo .env está en .gitignore: nunca se sube a GitHub.
#
#   PowerShell:  Copy-Item .env.example .env
#   Linux/macOS: cp .env.example .env

# Obligatoria para momios en vivo: https://the-odds-api.com/#get-access (gratis, 500 créditos/mes)
ODDS_API_KEY=

# Opcional y de pago: lesiones/calendario. El plan gratuito NO cubre la temporada actual; déjala vacía.
API_FOOTBALL_KEY=

# Opcional: alertas por Telegram (python main.py --telegram-setup te guía)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
